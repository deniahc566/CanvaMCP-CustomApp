# Copy to .env and fill in. Values already set in the environment (e.g. by `claude mcp add -e`) win over this file.

# From the Canva Developer Portal: your integration > Outside Canva > Configuration > Credentials.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Must match "Redirect URLs > URL 1" in the Developer Portal exactly (scheme, host, port and path).
# CANVA_REDIRECT_URI=http://127.0.0.1:3001/oauth/redirect

# Space-separated. Every scope here must also be ticked under Scopes in the Developer Portal.
# CANVA_SCOPES=design:meta:read design:content:read design:content:write folder:read folder:write asset:read asset:write comment:read comment:write brandtemplate:meta:read brandtemplate:content:read profile:read

# CANVA_TOKEN_FILE=~/.canva-mcp/tokens.json
# CANVA_DOWNLOAD_DIR=<os temp>/canva-mcp-exports
# CANVA_TOOL_PREFIX=canva_local_
# CANVA_JOB_TIMEOUT_MS=90000

# --- Editing bridge (the "canva-mcp bridge" app in the Canva editor) ---
# The app's origin, from the bridge app panel or "Developer Portal > your app > Security". Only this origin
# may connect. Unset accepts any https://app-*.canva-apps.com, i.e. any Canva app you open.
CANVA_BRIDGE_APP_ORIGIN=
# CANVA_BRIDGE=off                 # turn the bridge off
# CANVA_BRIDGE_APP_PORT=8080       # serves bridge-app/dist/app.js; must match the Development URL. 0 = don't serve
# CANVA_BRIDGE_TLS_PORT=3861       # wss:// for an uploaded app bundle (self-signed cert, or CANVA_BRIDGE_CERT/KEY). 0 = off
# CANVA_BRIDGE_TIMEOUT_MS=30000
