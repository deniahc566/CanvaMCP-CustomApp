{
  "name": "canva-mcp",
  "version": "0.1.0",
  "description": "Self-hosted Canva MCP server that mirrors the official Canva MCP tool interface, backed by the Canva Connect REST API with your own OAuth integration.",
  "type": "module",
  "bin": {
    "canva-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "bridge-app/dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:app",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "login": "node dist/index.js login",
    "status": "node dist/index.js status",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs",
    "build:app": "npm --prefix bridge-app run build",
    "postinstall": "npm --prefix bridge-app install --no-audit --no-fund",
    "try-bridge": "node scripts/try-bridge.mjs",
    "svg2canva": "node scripts/svg2canva.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
