{
  "name": "canva-mcp-bridge-app",
  "version": "0.1.0",
  "private": true,
  "description": "Canva app that connects the Canva editor to the local canva-mcp server so it can edit the open design.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs --serve",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@canva/asset": "2.3.1",
    "@canva/design": "2.13.1",
    "@canva/error": "2.2.2",
    "@canva/intents": "2.7.1",
    "@canva/platform": "2.2.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
